# For a physical device, use the development machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Customer and staff API workspaces; omit or set demo only for the offline prototype.
EXPO_PUBLIC_API_MODE=api
# Reachable Web host for SePay POST bridge, return pages and existing return-storage flow.
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000
