# Development defaults to the machine hosting Expo, including on a physical device.
# Override for a different backend or a deployed API. Do not use localhost on a phone.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api

# New authentication screens and the temporary signed-in home screen.
# Demo uses the offline auth adapter; archived screens are not registered in either mode.
EXPO_PUBLIC_API_MODE=api

# Web bridge used by the payment provider. Defaults to the Expo host on port 3000.
# EXPO_PUBLIC_WEB_BASE_URL=http://192.168.1.10:3000
