              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Create reservation: status\", () => pm.response.to.have.status(201));",
                  "const d=pm.response.json().data; pm.environment.set(\"reservationId\",d.id); pm.environment.set(\"totalAmount\",d.totalAmount); pm.test(\"Price and owner\",()=> {pm.expect(d.totalAmount).to.eql(300000);pm.expect(d.customerId).to.eql(pm.environment.get(\"customerId\"));});"
                ]
