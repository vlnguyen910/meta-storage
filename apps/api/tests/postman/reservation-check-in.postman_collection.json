        {
          "name": "Start payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}/make-payment",
            "body": {
              "mode": "raw",
              "raw": "{\"idempotencyKey\":\"{{$guid}}\",\"contactPhone\":\"0901234567\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Start payment: status\", () => pm.response.to.have.status(201));",
                  "const d=pm.response.json().data;pm.environment.set(\"paymentCode\",d.paymentCode);pm.environment.set(\"paymentId\",d.paymentId);pm.test(\"Signed checkout\",()=>pm.expect(d.checkoutUrl).to.be.a(\"string\"));",
                  "pm.test(\"Checkout success returns to Web\", () => { const url = new URL(d.checkoutFormFields.success_url); pm.expect(url.origin).to.eql(new URL(pm.environment.get(\"webUrl\")).origin); pm.expect(url.pathname).to.eql(\"/customer/payments/result\"); pm.expect(url.searchParams.get(\"paymentId\")).to.eql(d.paymentId); pm.expect(url.searchParams.get(\"reservationId\")).to.eql(d.reservationId); pm.expect(url.searchParams.get(\"status\")).to.eql(\"success\"); });",
                  "pm.test(\"Checkout error returns to Web\", () => { const url = new URL(d.checkoutFormFields.error_url); pm.expect(url.origin).to.eql(new URL(pm.environment.get(\"webUrl\")).origin); pm.expect(url.pathname).to.eql(\"/customer/payments/result\"); pm.expect(url.searchParams.get(\"paymentId\")).to.eql(d.paymentId); pm.expect(url.searchParams.get(\"reservationId\")).to.eql(d.reservationId); pm.expect(url.searchParams.get(\"status\")).to.eql(\"error\"); });",
                  "pm.test(\"Checkout cancel returns to Web\", () => { const url = new URL(d.checkoutFormFields.cancel_url); pm.expect(url.origin).to.eql(new URL(pm.environment.get(\"webUrl\")).origin); pm.expect(url.pathname).to.eql(\"/customer/payments/result\"); pm.expect(url.searchParams.get(\"paymentId\")).to.eql(d.paymentId); pm.expect(url.searchParams.get(\"reservationId\")).to.eql(d.reservationId); pm.expect(url.searchParams.get(\"status\")).to.eql(\"cancel\"); });"
                ]
              }
            }
          ]
