NODE_ENV=development
PORT=8080
HOST=0.0.0.0
# Comma-separated IPs/CIDRs of actual proxy peers; empty ignores forwarded IPs.
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=info
# Required; explicitly point to your database and Redis. No server fallback URLs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/metastorage
REDIS_URL=redis://localhost:6379
# Booking API prepares tracking/QR links; use the same magic secret in worker.
PUBLIC_APP_URL=http://localhost:3000
BOOKING_MAGIC_LINK_SECRET=replace-with-at-least-32-random-characters
QR_TOKEN_SECRET=replace-with-another-32-random-characters
# Optional: isolated Redis database for integration tests (never use production).
# REDIS_TEST_URL=redis://localhost:6379/15
CORS_ORIGIN=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Optional Google OAuth; configure both or leave both empty.
# Register BETTER_AUTH_URL + /callback/google as the authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_URL=http://localhost:8080/api/auth
BETTER_AUTH_SECRET=development-only-secret-change-before-production
# Required for signup verification and booking emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=metastorage <verify@example.com>
# SePay Payment Gateway requires merchant ID + secret.
PAYMENT_PROVIDER=sepay
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
WEB_URL=http://localhost:3000
SEPAY_PAYMENT_PREFIX=MS
# Optional display metadata for transferInstructions; never authenticates payments.
SEPAY_BANK_NAME=MBBank
SEPAY_BANK_ACCOUNT_NUMBER=0000000001
SEPAY_BANK_ACCOUNT_NAME=METASTORAGE

# Required: private images and files, including contract PDFs (server only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
