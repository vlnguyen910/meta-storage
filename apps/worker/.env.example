NODE_ENV=development
# Same PostgreSQL database as API; required for durable lifecycle notifications.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/metastorage
REDIS_URL=redis://localhost:6379
# Same values as API; dispatcher creates tracking links/QR for durable booking email.
PUBLIC_APP_URL=http://localhost:3000
QR_TOKEN_SECRET=
BOOKING_MAGIC_LINK_SECRET=
# Real delivery is tested on staging; there is no runtime mock provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=StoreX <bookings@example.com>
