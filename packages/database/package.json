{
  "name": "@metastorage/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./env": "./src/env.ts",
    "./seed-fixtures": "./src/seed-fixtures.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/seed.ts",
    "db:clear": "bun src/clear.ts",
    "lint": "biome check src",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@metastorage/contracts": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@metastorage/typescript-config": "workspace:*",
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3"
  }
}
