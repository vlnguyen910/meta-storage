# Copy to docker/app.env. API and worker both read this file.
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379

# Public API and auth configuration
CORS_ORIGIN=https://your-web-domain.example
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://your-api-domain.example/api/auth
AUTH_TRUSTED_ORIGINS=https://your-web-domain.example
WEB_URL=https://your-web-domain.example
PUBLIC_API_URL=https://your-api-domain.example

# API and worker must use the same secret to create and verify booking links.
BOOKING_MAGIC_LINK_SECRET=replace-with-at-least-32-random-characters

# Worker requires a configured mail provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Metastorage <verify@example.com>

PAYMENT_PROVIDER=sepay
SEPAY_ENV=production
SEPAY_TEST_MODE=false
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_WEBHOOK_API_KEY=
SEPAY_PAYMENT_PREFIX=MS
SEPAY_BANK_NAME=
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_ACCOUNT_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
